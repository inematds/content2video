{
  "version": 1,
  "output": {
    "directory": "output/content2video",
    "language": "pt-BR",
    "target_duration_seconds": 60,
    "minimum_duration_seconds": 42,
    "maximum_duration_seconds": 78
  },
  "narration": {
    "provider": "edge-tts",
    "voice_id": "pt-BR-FranciscaNeural",
    "lock_voice_across_scenes": true,
    "lock_voice_across_regenerations": true,
    "source_language_must_not_override_output_voice": true,
    "allow_change_only_on_explicit_user_request": true
  },
  "communication": {
    "conversation_style": "popular",
    "speech_pace": "natural",
    "voice_rate": "+0%",
    "explain_technical_terms": true,
    "prefer_short_sentences": true
  },
  "headline_safe_area": {
    "horizontal_inset_ratio": 0.075,
    "vertical_inset_ratio": 0.06,
    "maximum_width_ratio": 0.85,
    "maximum_block_height_ratio": 0.24,
    "measure_after_fonts_ready": true,
    "validate_animation_peak": true,
    "overflow_policy": "block_preview"
  }
}
