# Agente que pesquisa a fonte e constrói o projeto. Não seleciona um gerador de clipes de vídeo.
# OAuth da assinatura via login salvo no Codex CLI.
AI_PROVIDER=codex

# Para usar a OpenAI API, selecione openai e configure a chave somente no .env.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=

OUTPUT_LANGUAGE=pt-BR
TARGET_DURATION_SECONDS=60
DURATION_TOLERANCE_PERCENT=30
MINIMUM_DURATION_SECONDS=42
MAXIMUM_DURATION_SECONDS=78
MINIMUM_QUALITY_SCORE=8

VOICE_PROVIDER=edge-tts
VOICE_ID=pt-BR-FranciscaNeural
LOCK_VOICE=true
CONVERSATION_STYLE=popular
SPEECH_PACE=natural

VIDEO_ASPECT_RATIO=9:16
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_FORMAT=mp4
RENDER_QUALITY=high
RENDER_AFTER_APPROVAL=true

RENDERS_DIRECTORY_NAME=renders

# Escuta em todas as interfaces; restrinja o acesso à rede local no firewall.
APP_HOST=0.0.0.0
APP_PORT=3080
PREVIEW_HOST=0.0.0.0
PREVIEW_PORT=3022
